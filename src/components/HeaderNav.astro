---
// Sticky header that tightens slightly once the page scrolls (as on the old site).
---
<div class="header sticky bg-white -top-1">
  <div class="shadow-gray-400 flex flex-row items-center pt-3 pb-4 border-b border-violet-800">
    <a href="/">
      <img class="header__logo" src="/logo-512.png" alt="Luton International Church" width="48" height="48" />
    </a>
    <ul class="flex flex-col ml-3">
      <li>
        <h1 class="header__title text-lg capitalize font-bold text-violet-900 font-sans">Luton International Church</h1>
      </li>
      <li class="flex">
        <h2 class="header__tagline text-sm capitalize font-light text-violet-900 font-sans">Enlarging the tent to inherit the Nations</h2>
      </li>
    </ul>
  </div>
  <nav class="pb-2 ml-1 mt-2">
    <ul class="flex flex-row space-x-4 text-violet-900">
      <li><a class="border-b-4 border-white hover:border-violet-900 active:border-violet-600" href="#about">About</a></li>
      <li><a class="border-b-4 border-white hover:border-violet-900 active:border-violet-600" href="#outreach">Outreach</a></li>
      <li><a class="border-b-4 border-white hover:border-violet-900 active:border-violet-600" href="#services">Services</a></li>
      <li><a class="border-b-4 border-white hover:border-violet-900 active:border-violet-600" href="#contact">Contact</a></li>
    </ul>
  </nav>
</div>

<style>
  .header { z-index: 10; }
  .header__title { font-size: 1.125rem; }
  .header__tagline { font-size: 1rem; }
  .header__logo { width: 48px; height: 48px; }
  .header.is-scrolled { opacity: 0.95; box-shadow: rgba(0, 0, 0, 0.45) 0px 25px 20px -20px; }
  .header.is-scrolled .header__title { font-size: 0.95rem; }
  .header.is-scrolled .header__tagline { font-size: 0.8rem; }
  .header.is-scrolled .header__logo { width: 42px; }
</style>

<script>
  const header = document.querySelector('.header');
  const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 0);
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
